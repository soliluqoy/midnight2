{
	"name": "midnight-app",
	"productName": "midnight",
	"version": "0.4.0",
	"description": "midnight: a tray-first desktop launcher that plans, does and verifies work on your computer, in plain view",
	"author": "soliluqoy",
	"license": "MIT",
	"homepage": "https://github.com/soliluqoy/midnight2",
	"repository": "github:soliluqoy/midnight2",
	"private": true,
	"type": "module",
	"main": "src/main.mjs",
	"scripts": {
		"prestart": "node scripts/build-native.mjs",
		"start": "electron .",
		"test": "node --test --test-timeout=60000 \"test/**/*.test.mjs\"",
		"vendor": "node scripts/vendor-core.mjs",
		"predist": "node scripts/build-native.mjs",
		"dist": "electron-builder --publish never",
		"vendor:upstream": "node scripts/vendor-core.mjs --upstream 1.0.1",
		"sbom": "node scripts/sbom.mjs",
		"test:visual": "electron scripts/visual.mjs",
		"test:ui": "electron scripts/ui-check.mjs",
		"test:apps": "electron scripts/apps-check.mjs",
		"test:smoke": "node scripts/smoke.mjs",
		"test:search-model": "electron scripts/search-model.mjs",
		"build:native": "node scripts/build-native.mjs",
		"test:voice-model": "electron scripts/voice-model.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "file:vendor/earendil-works-chord-1.0.1.tgz",
		"@earendil-works/pi-agent-core": "file:vendor/earendil-works-pi-agent-core-1.0.1.tgz",
		"@earendil-works/pi-ai": "file:vendor/earendil-works-pi-ai-1.0.1.tgz",
		"@earendil-works/pi-codemode": "file:vendor/earendil-works-pi-codemode-1.0.1.tgz",
		"@earendil-works/pi-coding-agent": "file:vendor/earendil-works-pi-coding-agent-1.0.1.tgz",
		"@earendil-works/pi-mcp": "file:vendor/earendil-works-pi-mcp-1.0.1.tgz",
		"@earendil-works/pi-telemetry": "file:vendor/earendil-works-pi-telemetry-1.0.1.tgz",
		"@earendil-works/pi-tui": "file:vendor/earendil-works-pi-tui-1.0.1.tgz",
		"@huggingface/transformers": "^4.3.1",
		"pdfjs-dist": "^6.4.299",
		"sqlite-vec": "^0.1.9",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@electron/fuses": "^2.1.3",
		"electron": "44.4.5",
		"electron-builder": "26.15.3"
	},
	"overrides": {
		"@earendil-works/chord": "$@earendil-works/chord",
		"@earendil-works/pi-telemetry": "$@earendil-works/pi-telemetry",
		"@earendil-works/pi-ai": "$@earendil-works/pi-ai",
		"@earendil-works/pi-agent-core": "$@earendil-works/pi-agent-core",
		"@earendil-works/pi-tui": "$@earendil-works/pi-tui",
		"@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
		"@earendil-works/pi-mcp": "$@earendil-works/pi-mcp",
		"@earendil-works/pi-codemode": "$@earendil-works/pi-codemode"
	},
	"build": {
		"appId": "app.midnight.capsule",
		"productName": "midnight",
		"asar": true,
		"files": [
			"src/**/*",
			"package.json",
			"!src/**/*.test.*",
			"!src/**/__pycache__/**",
			"!src/desktop/native/*.cs",
			"!node_modules/onnxruntime-web/**",
			"!node_modules/@napi-rs/**",
			"!node_modules/@earendil-works/pi-tui/native/**",
			"!test/**"
		],
		"directories": {
			"output": "release"
		},
		"artifactName": "midnight-${os}-${arch}.${ext}",
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64"
					]
				}
			],
			"signAndEditExecutable": true,
			"verifyUpdateCodeSignature": true,
			"files": [
				"!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
				"!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
			],
			"signExts": [
				".exe"
			]
		},
		"mac": {
			"target": [
				{
					"target": "zip",
					"arch": [
						"arm64"
					]
				}
			],
			"category": "public.app-category.productivity",
			"identity": null,
			"files": [
				"!node_modules/onnxruntime-node/bin/napi-v6/{win32,linux}/**",
				"!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**"
			]
		},
		"linux": {
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			],
			"category": "Utility",
			"files": [
				"!node_modules/onnxruntime-node/bin/napi-v6/{win32,darwin}/**",
				"!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"allowElevation": false,
			"createDesktopShortcut": false,
			"createStartMenuShortcut": true,
			"shortcutName": "midnight",
			"deleteAppDataOnUninstall": false,
			"artifactName": "midnight-setup-${arch}.${ext}"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "soliluqoy",
				"repo": "midnight2",
				"releaseType": "release"
			}
		],
		"asarUnpack": [
			"**/*.node",
			"**/*.dll",
			"**/*.exe",
			"**/*.ps1",
			"src/desktop/native/**",
			"node_modules/sqlite-vec*/**",
			"node_modules/onnxruntime-node/bin/**",
			"node_modules/@img/**",
			"node_modules/sharp/**"
		],
		"afterPack": "scripts/after-pack.cjs"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"protobufjs@7.6.6": true,
		"electron@44.4.5": true,
		"electron-winstaller@5.4.0": true
	}
}
